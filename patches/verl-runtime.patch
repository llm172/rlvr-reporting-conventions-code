+# See the License for the specific language governing permissions and
+# limitations under the License.
+"""Strict prompt-level importance correction for target-preserving RLVR."""
+
+from __future__ import annotations
+
+from typing import Any
+
+import torch
+from omegaconf import OmegaConf
+
+from verl import DataProto
+
+
+def _prompt_sampling_config(config) -> Any:
+    return OmegaConf.select(config, "algorithm.prompt_sampling", default=None)
+
+
+def _enum_value(value) -> str:
+    return str(getattr(value, "value", value)).lower()
+
+
+def validate_prompt_sampling_config(config) -> None:
+    """Reject settings outside the strict target-preservation interpretation."""
+
+    sampling_config = _prompt_sampling_config(config)
+    if sampling_config is None or not bool(sampling_config.get("enabled", False)):
+        return
+    if not bool(sampling_config.get("strict_target_preservation", True)):
+        return
+    if not bool(sampling_config.get("apply_importance_correction", True)):
+        raise ValueError("strict target preservation requires prompt importance correction")
+
+    adv_estimator = OmegaConf.select(config, "algorithm.adv_estimator")
+    if _enum_value(adv_estimator) != "grpo":
+        raise ValueError("strict prompt sampling currently requires GRPO")
+
+    actor = OmegaConf.select(config, "actor_rollout_ref.actor")
+    if actor is None:
+        raise ValueError("strict prompt sampling requires actor configuration")
+    if float(actor.get("entropy_coeff", 0.0)) != 0.0:
+        raise ValueError("strict prompt sampling requires zero actor entropy coefficient")
+    if bool(actor.get("use_kl_loss", False)):
+        raise ValueError("strict prompt sampling does not support an auxiliary actor KL loss")
+    if int(actor.get("ppo_epochs", 1)) != 1:
+        raise ValueError("strict prompt sampling requires exactly one PPO epoch")
+    train_batch_size = OmegaConf.select(config, "data.train_batch_size")
+    ppo_mini_batch_size = actor.get("ppo_mini_batch_size")
+    if train_batch_size is None or ppo_mini_batch_size is None:
+        raise ValueError("strict prompt sampling requires explicit data.train_batch_size and actor.ppo_mini_batch_size")
+    if int(ppo_mini_batch_size) != int(train_batch_size):
+        raise ValueError(
+            "strict prompt sampling requires one actor optimizer step per rollout batch: "
+            "actor.ppo_mini_batch_size must equal data.train_batch_size"
+        )
+    if actor.get("loss_agg_mode") != "seq-mean-token-mean":
+        raise ValueError("strict prompt sampling requires loss_agg_mode=seq-mean-token-mean")
+    loss_mode = actor.get("policy_loss", {}).get("loss_mode", "vanilla")
+    if loss_mode != "vanilla":
+        raise ValueError("strict prompt sampling currently requires the vanilla policy loss")
+
+
+def _require_vector(batch: DataProto, key: str, batch_size: int) -> torch.Tensor:
+    if key not in batch.batch:
+        raise KeyError(f"batch is missing required prompt-sampling tensor {key!r}")
+    value = batch.batch[key]
+    if value.ndim != 1 or value.shape[0] != batch_size:
+        raise ValueError(f"{key} must be a vector with one value per generated response")
+    return value
+
+
+def _validate_positive_finite(value: torch.Tensor, key: str) -> None:
+    if not torch.isfinite(value).all():
+        raise ValueError(f"{key} must be finite")
+    if not torch.all(value > 0):
+        raise ValueError(f"{key} must be positive")
+
+
+def _draw_representatives(
+    draw_number: torch.Tensor,
+    sampling_index: torch.Tensor,
+    sampling_stratum: torch.Tensor,
+    target: torch.Tensor,
+    proposal: torch.Tensor,
+    weight: torch.Tensor,
+) -> torch.Tensor:
+    if draw_number.dtype == torch.bool or draw_number.is_floating_point():
+        raise ValueError("sampling_draw_number must be integer encoded")
+    if sampling_index.dtype == torch.bool or sampling_index.is_floating_point():
+        raise ValueError("sampling_index must be integer encoded")
+    if sampling_stratum.dtype == torch.bool or sampling_stratum.is_floating_point():
+        raise ValueError("sampling_stratum must be integer encoded")
+    if torch.any(draw_number < 0):
+        raise ValueError("sampling_draw_number must be non-negative when prompt sampling is enabled")
+
+    representatives = []
+    for draw in torch.unique(draw_number, sorted=True):
+        positions = torch.nonzero(draw_number == draw, as_tuple=False).flatten()
+        representatives.append(positions[0])
+        for metadata, name in (
+            (sampling_index, "sampling_index"),
+            (sampling_stratum, "sampling_stratum"),
+        ):
+            if not torch.equal(metadata[positions], metadata[positions[0]].expand_as(metadata[positions])):
+                raise ValueError(f"{name} is inconsistent within a repeated prompt draw")
+        for metadata, name in (
+            (target, "sampling_target_probability"),
+            (proposal, "sampling_proposal_probability"),
+            (weight, "sampling_importance_weight"),
+        ):
+            repeated = metadata[positions]
+            if not torch.allclose(repeated, repeated[0].expand_as(repeated), rtol=1e-12, atol=0.0):
+                raise ValueError(f"{name} is inconsistent within a repeated prompt draw")
+    return torch.stack(representatives)
+
+
+def apply_prompt_sampling_correction(batch: DataProto, config) -> dict[str, float]:
+    """Apply exact ``rho/q`` weights to the GRPO policy-gradient advantages.
+
+    This preserves the conditional mean of the sampled GRPO surrogate-gradient
+    contribution under the fixed target distribution.  It does not make Adam
+    parameters or final returns unbiased.
+    """
+
+    sampling_config = _prompt_sampling_config(config)
+    if sampling_config is None or not bool(sampling_config.get("enabled", False)):
+        return {}
+    validate_prompt_sampling_config(config)
+
+    if "sampling_second_moment_proxy" in batch.batch:
+        raise ValueError("prompt sampling correction has already been applied to this batch")
+    if "advantages" not in batch.batch or "response_mask" not in batch.batch:
+        raise KeyError("batch must contain advantages and response_mask before prompt correction")
+    advantages = batch.batch["advantages"]
+    response_mask = batch.batch["response_mask"]
+    if advantages.ndim != 2 or response_mask.shape != advantages.shape:
+        raise ValueError("advantages and response_mask must have matching [batch, response] shapes")
+    batch_size = advantages.shape[0]
+
+    sampling_index = _require_vector(batch, "sampling_index", batch_size)
+    sampling_stratum = _require_vector(batch, "sampling_stratum", batch_size)
+    draw_number = _require_vector(batch, "sampling_draw_number", batch_size)
+    target = _require_vector(batch, "sampling_target_probability", batch_size).to(torch.float64)
+    proposal = _require_vector(batch, "sampling_proposal_probability", batch_size).to(torch.float64)
+    weight = _require_vector(batch, "sampling_importance_weight", batch_size).to(torch.float64)
+    _validate_positive_finite(target, "sampling_target_probability")
+    _validate_positive_finite(proposal, "sampling_proposal_probability")
+    _validate_positive_finite(weight, "sampling_importance_weight")
+    expected_weight = target / proposal
+    if not torch.allclose(weight, expected_weight, rtol=1e-12, atol=0.0):
+        raise ValueError("sampling_importance_weight must equal target_probability / proposal_probability")
+
+    representatives = _draw_representatives(
+        draw_number,
+        sampling_index,
+        sampling_stratum,
+        target,
+        proposal,
+        weight,
+    )
+
+    mask = response_mask.to(dtype=advantages.dtype)
+    valid_token_count = mask.sum(dim=-1)
+    if torch.any(valid_token_count <= 0):
+        raise ValueError("every generated response must contain at least one valid response token")
+    raw_second_moment_proxy = (advantages.square() * mask).sum(dim=-1) / valid_token_count
+    batch.batch["sampling_second_moment_proxy"] = raw_second_moment_proxy.detach()
+    apply_correction = bool(sampling_config.get("apply_importance_correction", True))
+    if apply_correction:
+        batch.batch["advantages"] = advantages * weight.to(device=advantages.device, dtype=advantages.dtype)[:, None]
+
+    draw_weight = weight[representatives]
+    draw_proposal = proposal[representatives]
+    weight_sum = draw_weight.sum()
+    ess = weight_sum.square() / draw_weight.square().sum()
+    cross_entropy_estimate = torch.mean(draw_weight * -torch.log(draw_proposal))
+    kl_estimate = torch.mean(draw_weight * torch.log(draw_weight))
+    draw_count = draw_weight.numel()
+    return {
+        "sampling/importance_weight_mean": draw_weight.mean().item(),
+        "sampling/importance_weight_min": draw_weight.min().item(),
+        "sampling/importance_weight_max": draw_weight.max().item(),
+        "sampling/importance_weight_ess": ess.item(),
+        "sampling/importance_weight_ess_fraction": (ess / draw_count).item(),
+        "sampling/target_proposal_cross_entropy_estimate": cross_entropy_estimate.item(),
+        "sampling/target_proposal_kl_estimate": kl_estimate.item(),
+        "sampling/min_proposal_probability": draw_proposal.min().item(),
+        "sampling/draw_count": float(draw_count),
+        "sampling/correction_applied": float(apply_correction),
+        "budget/sampled_prompts": float(draw_count),
+        "budget/completions": float(batch_size),
+        "budget/generated_tokens": float(response_mask.sum().item()),
+        "budget/reward_evaluations": float(batch_size),
+        "budget/actor_optimizer_updates": 1.0,
+    }
